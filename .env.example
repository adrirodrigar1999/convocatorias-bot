# Copia este fichero a .env y rellénalo (en el Mac; en GitHub van como secretos)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Días en que toca revisar (lun,mar,mie,jue,vie,sab,dom) y a partir de qué hora.
# Si el Mac está apagado ese día, revisa en cuanto lo enciendas.
DIAS_EJECUCION=lun,jue
HORA_EJECUCION=09:00

RESUMEN_DIARIO=0            # 1 = mensaje silencioso tras cada revisión con el recuento
DIAS_PRIMERA_EJECUCION=45   # en la primera revisión mira 45 días atrás y avisa de lo que siga abierto

# Opcional: afina con IA los casos "revisa la titulación"
ANTHROPIC_API_KEY=
