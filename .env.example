# Copia este fichero a .env y rellénalo
TELEGRAM_TOKEN=123456789:ABC...      # te lo da @BotFather
TELEGRAM_CHAT_ID=123456789           # tu chat, grupo o canal (canal: -100...)

HORA_EJECUCION=08:30
RESUMEN_DIARIO=1                     # mensaje silencioso diario aunque no haya novedades
DIAS_PRIMERA_EJECUCION=45            # en el primer arranque revisa 45 días y avisa de las que siguen abiertas

# Opcional: afina con IA los casos "revisa la titulación"
ANTHROPIC_API_KEY=
